# Local RAG Knowledge Base
RAGKB_APP_NAME=Local RAG Knowledge Base
RAGKB_HOST=127.0.0.1
RAGKB_PORT=18080
RAGKB_PORT_CANDIDATES=
RAGKB_PORT_SCAN_LIMIT=50
RAGKB_LOG_LEVEL=INFO
RAGKB_DATA_DIR=data
RAGKB_KNOWLEDGE_DIR=knowledge
RAGKB_LOG_DIR=logs
RAGKB_STATIC_DIR=static
# Memory subsystem (disabled by default)
RAGKB_MEMORY_ENABLED=false
RAGKB_MEMORY_DB_PATH=
RAGKB_MEMORY_CONTEXT_ENABLED=false
RAGKB_MEMORY_FAST_MEMORY=false
RAGKB_MEMORY_CONTEXT_BUDGET=900
RAGKB_MEMORY_RECENT_HISTORY_MESSAGES=8
RAGKB_MEMORY_RECENT_HISTORY_TOKENS=1200
RAGKB_MEMORY_UPSTREAM_HISTORY=off
RAGKB_MEMORY_UPSTREAM_MEMORY=off
RAGKB_CHAT_TOPIC_FILTER=false
RAGKB_MEMORY_RECALL_ENABLED=false
RAGKB_MEMORY_RECALL_BUDGET=400
RAGKB_MEMORY_RECALL_MAX_ITEMS=5
RAGKB_MEMORY_AUTO_EXTRACT=false
RAGKB_MEMORY_WORKER=false
RAGKB_MEMORY_EXTRACT_EVERY_TURNS=6
RAGKB_MEMORY_EXTRACT_MAX_MESSAGES=20
RAGKB_MEMORY_EXTRACT_MAX_INPUT_TOKENS=4000
RAGKB_MEMORY_EXTRACT_BACKEND=off
RAGKB_MEMORY_CLOUD_EXTRACT=false
RAGKB_MEMORY_EXTRACT_DEBOUNCE_SECONDS=300
RAGKB_MEMORY_BACKUP_KEEP=14
# Document ingestion
RAGKB_INGEST_ALLOWED_EXTENSIONS=.txt,.md,.pdf,.docx,.csv,.xlsx,.xls,.pptx,.json,.html,.htm,.jpg,.jpeg,.png,.webp,.bmp
RAGKB_INGEST_MAX_UPLOAD_SIZE=104857600
RAGKB_INGEST_PARSE_MAX_CHARS=2000000
RAGKB_INGEST_PARSE_MAX_ASSETS=50
RAGKB_INGEST_PARSE_MAX_ASSET_MB=10
RAGKB_INGEST_UPLOAD_DIR=data/uploads
RAGKB_INGEST_PARSED_DIR=data/parsed
RAGKB_INGEST_QUALITY_PROFILE=standard
RAGKB_INGEST_QUALITY_MIN_CHARS=50
RAGKB_INGEST_QUALITY_MIN_READABLE_RATIO=0.60
RAGKB_INGEST_QUALITY_MAX_GARBLED_RATIO=0.05
RAGKB_INGEST_QUALITY_MAX_REPEAT_RATIO=0.40
RAGKB_INGEST_QUALITY_MIN_CHARS_PER_PAGE=100
RAGKB_INGEST_QUALITY_PASS_SCORE=70
RAGKB_INGEST_QUALITY_MAX_UNOCR_IMAGES=0
RAGKB_INGEST_QUALITY_OCR_ROUTES=pdf,image

# Knowledge service and LightRAG shell
RAGKB_LIGHTRAG_URL=http://127.0.0.1:10261
RAGKB_LIGHTRAG_TIMEOUT=120
RAGKB_LIGHTRAG_CONNECT_TIMEOUT=5
RAGKB_LIGHTRAG_VERIFY_TLS=true
RAGKB_LIGHTRAG_SHELL_HOST=127.0.0.1
RAGKB_LIGHTRAG_SHELL_PORT=10261
RAGKB_LIGHTRAG_SHELL_PORT_SCAN_LIMIT=20
RAGKB_LIGHTRAG_BACKEND_URL=
RAGKB_LIGHTRAG_BACKEND_TIMEOUT=120

# Unified lifecycle
RAGKB_LIGHTRAG_ENGINE_HOST=127.0.0.1
RAGKB_LIGHTRAG_ENGINE_PORT=10262
RAGKB_LIGHTRAG_ENGINE_PORT_SCAN_LIMIT=20
RAGKB_LIFECYCLE_START_TIMEOUT=120
RAGKB_LIFECYCLE_STOP_TIMEOUT=20
RAGKB_WEB_STOP_ENABLED=1
